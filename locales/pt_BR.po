#: templates/config.html.twig:17
msgid "Active"
msgstr "Ativo"

#: templates/config.html.twig:21
msgid "Connection to Chatwoot"
msgstr "Conexão com o Chatwoot"

#: templates/config.html.twig:24
msgid "Website Token and HMAC Token don't need to be typed in: they are automatically fetched from the Chatwoot API when saving, based on the Account ID and Inbox ID below."
msgstr "Website Token e HMAC Token não precisam ser digitados: são buscados automaticamente na API do Chatwoot ao salvar, a partir do Account ID e do Inbox ID abaixo."

#: templates/config.html.twig:28 front/config.form.php:43
msgid "Chatwoot URL"
msgstr "URL do Chatwoot"

#: templates/config.html.twig:30
msgid "Base address of your Chatwoot instance (no trailing slash)."
msgstr "Endereço base da sua instância do Chatwoot (sem barra no final)."

#: templates/config.html.twig:34 front/config.form.php:51
msgid "API Access Token"
msgstr "API Access Token"

#: templates/config.html.twig:37
msgid "•••••••• (configured — leave blank to keep)"
msgstr "•••••••• (configurado — deixe em branco para manter)"

#: templates/config.html.twig:40
msgid "Agent profile > Profile settings > \"Access Token\". Never re-displayed once saved — leave blank to keep the current value."
msgstr "Perfil do agente > Configurações de perfil > \"Access Token\". Nunca é exibido novamente depois de salvo — deixe em branco para manter o valor atual."

#: templates/config.html.twig:46 front/config.form.php:44
msgid "Account ID"
msgstr "Account ID"

#: templates/config.html.twig:52 front/config.form.php:45
msgid "Inbox ID"
msgstr "Inbox ID"

#: templates/config.html.twig:60
msgid "Widget customization"
msgstr "Personalização do widget"

#: templates/config.html.twig:63
msgid "The Chatwoot API does not return the Widget Builder options (position, type, launcher title) — configure them here to apply them on top of the automatically fetched script."
msgstr "A API do Chatwoot não devolve as opções do Widget Builder (posição, tipo, título do botão) — configure aqui para aplicar por cima do script buscado automaticamente."

#: templates/config.html.twig:69
msgid "Position"
msgstr "Posição"

#: templates/config.html.twig:71
msgid "Right"
msgstr "Direita"

#: templates/config.html.twig:72
msgid "Left"
msgstr "Esquerda"

#: templates/config.html.twig:78
msgid "Bubble type"
msgstr "Tipo de bolha"

#: templates/config.html.twig:80
msgid "Expanded bubble"
msgstr "Bolha expandida"

#: templates/config.html.twig:81
msgid "Standard"
msgstr "Padrão"

#: templates/config.html.twig:87
msgid "Launcher title"
msgstr "Título do botão"

#: templates/config.html.twig:89
msgid "Only shows up with the \"Expanded bubble\" type."
msgstr "Só aparece no tipo \"Bolha expandida\"."

#: templates/config.html.twig:94
msgid "Dark mode"
msgstr "Modo escuro"

#: templates/config.html.twig:96
msgid "Automatic (follows the browser)"
msgstr "Automático (segue o navegador)"

#: templates/config.html.twig:97
msgid "Always light"
msgstr "Sempre claro"

#: templates/config.html.twig:98
msgid "Always dark"
msgstr "Sempre escuro"

#: templates/config.html.twig:106
msgid "Who can see the widget"
msgstr "Quem pode ver o widget"

#: templates/config.html.twig:109
msgid "Leave all three fields empty to show the widget to every authenticated user. Select profiles, groups, and/or users to restrict visibility to them."
msgstr "Deixe os três campos vazios para exibir o widget a todos os usuários autenticados. Selecione perfis, grupos e/ou usuários para restringir a visibilidade a eles."

#: templates/config.html.twig:115
msgid "Profiles"
msgstr "Perfis"

#: templates/config.html.twig:120 templates/config.html.twig:132 templates/config.html.twig:144 templates/config.html.twig:178
msgid "Type to search…"
msgstr "Digite para buscar…"

#: templates/config.html.twig:127
msgid "Groups"
msgstr "Grupos"

#: templates/config.html.twig:139
msgid "Users"
msgstr "Usuários"

#: templates/config.html.twig:153
msgid "Dashboard App panel security"
msgstr "Segurança do painel (Dashboard App)"

#: templates/config.html.twig:156
msgid "The \"GLPI\" panel inside Chatwoot has no GLPI session — these options control exactly what it is allowed to expose."
msgstr "O painel \"GLPI\" dentro do Chatwoot não tem sessão do GLPI — estas opções controlam exatamente o que ele pode exibir."

#: templates/config.html.twig:163
msgid "Show internal/private follow-ups to Chatwoot agents"
msgstr "Mostrar acompanhamentos internos/privados aos agentes do Chatwoot"

#: templates/config.html.twig:165
msgid "Public follow-ups (the ticket history the requester also sees) are always shown. This option only controls follow-ups marked as Private in GLPI — technicians' internal notes. Off by default."
msgstr "Os acompanhamentos públicos (o histórico do chamado que o solicitante também vê) são sempre exibidos. Esta opção controla apenas os acompanhamentos marcados como Privado no GLPI — as notas internas dos técnicos. Desativada por padrão."

#: templates/config.html.twig:171
msgid "Restrict the panel to specific entities"
msgstr "Restringir o painel a entidades específicas"

#: templates/config.html.twig:181
msgid "Selecting an entity also includes its sub-entities. When enabled with no entity selected, the panel shows no tickets at all, rather than every entity."
msgstr "Selecionar uma entidade inclui também as suas subentidades. Se ativado sem nenhuma entidade selecionada, o painel não mostra nenhum chamado, em vez de mostrar todas as entidades."

#: templates/config.html.twig:186
msgid "Regenerate the Dashboard panel token? The panel will stop working in Chatwoot until it reloads with the new one."
msgstr "Gerar um novo token para o painel? O painel deixará de funcionar no Chatwoot até ser recarregado com o novo token."

#: templates/config.html.twig:187
msgid "Regenerate panel token"
msgstr "Gerar novo token do painel"

#: templates/config.html.twig:189
msgid "Use this if the token may have leaked (e.g. an agent who had access left)."
msgstr "Use se o token puder ter vazado (ex.: saída de um agente que tinha acesso)."

#: templates/config.html.twig:197
msgid "Test connection"
msgstr "Testar conexão"

#: templates/config.html.twig:286
msgid "Nothing found."
msgstr "Nada encontrado."

#: templates/config.html.twig:361
msgid "Error testing the connection."
msgstr "Erro ao testar a conexão."

#: templates/config.html.twig:373
msgid "You don't have permission to change the Chatwoot configuration."
msgstr "Você não possui permissão para alterar a configuração do Chatwoot."
